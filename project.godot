; Engine configuration file.

config_version=5

[application]

config/name="Supercell: The Game"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

ScreenshotTool="*res://scripts/dev/screenshot_tool.gd"
DisplayManager="*res://scripts/ui/display_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d.mobile=1
scaling_3d/mode.mobile=0
scaling_3d/scale.mobile=0.75
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=3
camera/depth_of_field/depth_of_field_use_jitter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

[shader_globals]

player_position={
"type": "vec3",
"value": Vector3(0, -100, 0)
}
world_time={
"type": "float",
"value": 0.0
}
night_amount={
"type": "float",
"value": 0.0
}
cloud_shadow_map={
"type": "sampler2D",
"value": ""
}
cloud_shadow_rect={
"type": "vec4",
"value": Vector4(-110, -110, 220, 220)
}
liquid_wetness_map={
"type": "sampler2D",
"value": ""
}
liquid_area={
"type": "vec4",
"value": Vector4(0, 0, 1, 1)
}
pond_splash={
"type": "vec4",
"value": Vector4(0, 0, -100, 0)
}
